.skill-input{width:100%;min-height:84px;resize:vertical;border:1px solid var(--rule-strong);border-radius:12px;padding:12px;background:#fff;font:inherit;color:var(--ink)}
.skill-input:focus{outline:none;border-color:var(--excel-mid);box-shadow:0 0 0 3px rgba(33,115,70,.12)}
.skill-actions{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}
.skill-submit{display:inline-flex;align-items:center;gap:7px;padding:10px 14px;border-radius:10px;background:var(--excel-darkest);color:#fff;font-size:13px;font-weight:700}
.skill-submit[disabled]{opacity:.55;cursor:not-allowed}
.skill-reward{font-size:12px;font-weight:800;color:var(--excel-mid)}
.skill-state{font-size:12px;color:var(--muted)}
.skill-node.done .skill-task{border-color:rgba(33,115,70,.24);background:linear-gradient(180deg,var(--mint-soft),#fff)}

footer{padding:48px 24px 32px;max-width:1280px;margin:0 auto;border-top:1px solid var(--rule);margin-top:80px}
.foot-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:32px;margin-bottom:32px}
@media(max-width:760px){.foot-grid{grid-template-columns:1fr 1fr}} @media(max-width:480px){.foot-grid{grid-template-columns:1fr}}
.foot-col h4{font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;margin-bottom:14px}.foot-col ul{list-style:none;display:flex;flex-direction:column;gap:8px}
.foot-col a{font-size:13.5px;color:var(--muted);transition:.15s}.foot-col a:hover{color:var(--excel-mid)}
.foot-brand{font-family:'Fraunces',serif;font-size:24px;font-weight:700;letter-spacing:-.02em;margin-bottom:8px}
.foot-tag{font-size:13px;color:var(--muted);max-width:320px;line-height:1.55;margin-bottom:14px}
.foot-bottom{padding-top:24px;border-top:1px solid var(--rule);display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;font-size:12px;color:var(--muted-2)}
.toast-wrap{position:fixed;right:18px;bottom:18px;z-index:80;display:flex;flex-direction:column;gap:8px}
.toast{background:var(--ink);color:var(--cream);padding:11px 16px;border-radius:10px;font-size:13px;font-weight:600;box-shadow:var(--shadow-lg);border:1px solid rgba(250,247,239,.1);animation:slideIn .25s cubic-bezier(.2,.9,.4,1);display:flex;align-items:center;gap:8px}
@keyframes slideIn{from{opacity:0;transform:translateX(40px)}to{opacity:1;transform:translateX(0)}}
.toast.ok::before{content:'✓';color:var(--excel-glow);font-weight:800}
.reveal{opacity:0;transform:translateY(20px);transition:opacity .8s ease,transform .8s cubic-bezier(.2,.9,.4,1)} .reveal.in{opacity:1;transform:translateY(0)}
