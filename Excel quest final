.skill-badge.locked{background:#f5eee8;color:var(--rust)}
.skill-badge.done{background:rgba(95,200,138,.18);color:var(--excel-darkest)}
.skill-lock{margin-left:auto;color:var(--muted-2);font-size:14px}
.skill-foot{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:auto}
.skill-hint{font-size:12px;color:var(--muted-2);margin-top:2px}

.skill-task{margin-top:2px;padding:12px;border:1px dashed var(--rule-strong);border-radius:12px;background:#fff;display:grid;gap:10px}
.skill-task strong{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--excel-dark);margin-bottom:4px}
.skill-task p{font-size:13px;color:var(--ink-soft);line-height:1.5}
