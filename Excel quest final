<script>
'use strict';

function toast(msg,type='ok'){
  const wrap=document.getElementById('toastWrap');
  const el=document.createElement('div');
  el.className='toast '+type;
  el.textContent=msg;
  wrap.appendChild(el);
  setTimeout(()=>{el.style.opacity='0';el.style.transform='translateX(20px)';el.style.transition='all .2s';setTimeout(()=>el.remove(),220)},2200);
}

function readJSON(key){
  try{return JSON.parse(localStorage.getItem(key)||'null')}catch{return null}
}
function asArray(v){
  if(Array.isArray(v)) return v;
  if(v && typeof v==='object') return Object.values(v).filter(Boolean);
  return [];
}
function getFirstValue(keys, fallback=null){
  for(const key of keys){
    const raw=localStorage.getItem(key);
    if(raw===null) continue;
    try{
      const parsed=JSON.parse(raw);
      if(parsed!==null && parsed!==undefined) return parsed;
    }catch{}
    return raw;
  }
  return fallback;
}
function inferArrayByKeyword(words){
  const out=[];
  for(let i=0;i<localStorage.length;i++){
    const key=localStorage.key(i);
    const low=key.toLowerCase();
    if(words.some(w=>low.includes(w))){
      const parsed=readJSON(key);
      if(Array.isArray(parsed)) out.push(...parsed);
      else if(parsed && typeof parsed==='object') out.push(...Object.keys(parsed));
    }
  }
  return [...new Set(out)];
}
function inferNumberByKeyword(words){
  let best=0;
  for(let i=0;i<localStorage.length;i++){
    const key=localStorage.key(i);
    const low=key.toLowerCase();
    if(words.some(w=>low.includes(w))){
      const raw=localStorage.getItem(key);
      const n=Number(raw);
      if(!Number.isNaN(n) && n>best) best=n;
      const parsed=readJSON(key);
      if(typeof parsed==='number' && parsed>best) best=parsed;
      if(parsed && typeof parsed==='object'){
        for(const val of Object.values(parsed)){
          const nv=Number(val);
          if(!Number.isNaN(nv) && nv>best) best=nv;
        }
      }
    }
  }
  return best;
}
function guessNextNode(skillsCount,xp){
  if(skillsCount >= 10) return 'Boss Final · Dashboard Executiv';
  if(skillsCount >= 7) return 'Boss Intermediar · Forecast Panic';
  if(skillsCount >= 4) return 'Boss Catalogul Rupt';
  if(skillsCount >= 1) return 'IF Logic';
  return 'Formula Basics';
}
function computeLevel(xp, skills){
  if(xp >= 260 || skills >= 9) return 'Advanced';
  if(xp >= 90 || skills >= 4) return 'Intermediate';
  return 'Beginner';
}
function resumeHref(nextNode){
  const slug = encodeURIComponent(nextNode);
  return 'https://laurandreea10.github.io/Excel-Quest/enhanced-pro-v2.html#skills';
}

const skillTreeKey = 'eqHubSkillTreeAnswers';
function readSkillTreeState(){
  const saved = readJSON(skillTreeKey);
  return saved && typeof saved === 'object' ? saved : {};
}
function writeSkillTreeState(state){
  localStorage.setItem(skillTreeKey, JSON.stringify(state));
}
function unlockSkill(node){
  if(!node || node.classList.contains('done')) return;
  node.classList.remove('locked');
  node.classList.add('available');
  const badge = node.querySelector('.skill-badge');
  if(badge){ badge.className = 'skill-badge available'; badge.textContent = '▶ Disponibil'; }
  const input = node.querySelector('.skill-input');
  const btn = node.querySelector('.skill-submit');
  if(input) input.disabled = false;
  if(btn) btn.disabled = false;
  const lock = node.querySelector('.skill-lock');
  if(lock) lock.textContent = '→';
  const state = node.querySelector('.skill-state');
  if(state) state.textContent = 'Skill disponibil. Trimite răspunsul ca la Weekly Challenge.';
}
function completeSkill(node, value){
  node.classList.remove('locked','available');
  node.classList.add('done');
  const badge = node.querySelector('.skill-badge');
  if(badge){ badge.className = 'skill-badge done'; badge.textContent = '✓ Completat'; }
  const input = node.querySelector('.skill-input');
  const btn = node.querySelector('.skill-submit');
  if(input){ input.disabled = true; input.value = value; }
  if(btn){ btn.disabled = true; btn.textContent = '✓ Trimis'; }
  const lock = node.querySelector('.skill-lock');
  if(lock) lock.textContent = '✓';
  const state = node.querySelector('.skill-state');
  if(state) state.textContent = 'Răspuns salvat local. Skill completat.';
}
function updateTierProgress(){
  document.querySelectorAll('.skill-tier').forEach(tier => {
    const nodes = [...tier.querySelectorAll('.skill-node')];
    const done = nodes.filter(n => n.classList.contains('done')).length;
    const total = Number(tier.dataset.total || nodes.length || 1);
    const percent = Math.round((done/total)*100);
    const count = tier.querySelector('.tier-count');
    const meta = tier.querySelector('.tier-meta');
    const progress = tier.querySelector('.skill-progress span');
    if(count) count.textContent = done;
    if(progress) progress.style.width = percent + '%';
    if(meta){
      const label = tier.dataset.tier === 'beginner' ? `${percent}%` : (done===0 && !nodes.some(n=>!n.classList.contains('locked')) ? `🔒 Finalizează nivelul anterior · ${percent}%` : `${percent}%`);
      meta.textContent = label;
    }
  });
}
function initSkillTree(){
  const wrap = document.getElementById('interactiveSkillTree');
  if(!wrap) return;
  const nodes = [...wrap.querySelectorAll('.skill-node')];
  const state = readSkillTreeState();

  nodes.forEach((node, index) => {
    const id = node.dataset.skillId;
    const saved = state[id];
    if(saved && saved.completed){ completeSkill(node, saved.answer || ''); }
    const btn = node.querySelector('.skill-submit');
    const input = node.querySelector('.skill-input');
    if(btn){
      btn.addEventListener('click', () => {
        if(node.classList.contains('locked')) return;
        const value = (input?.value || '').trim();
        if(!value){ toast('Scrie un răspuns înainte să trimiți'); return; }
        state[id] = { completed:true, answer:value, tier:node.dataset.tierName, xp:Number(node.dataset.xp || 0) };
        writeSkillTreeState(state);
        completeSkill(node, value);
        unlockSkill(nodes[index+1]);
        updateTierProgress();
        toast(`${node.querySelector('h4')?.textContent || 'Skill'} completat`);
      });
    }
  });

  const firstIncomplete = nodes.find(n => !n.classList.contains('done'));
  if(firstIncomplete && firstIncomplete.classList.contains('locked')) unlockSkill(firstIncomplete);
  nodes.forEach((node, index) => {
    if(node.classList.contains('done')) unlockSkill(nodes[index+1]);
  });
  updateTierProgress();
}
function bridgeProgress(){
  // Put your exact Pro v2 keys first here when you know them.
  const xpDirect = getFirstValue(['eq-xp','eqXP','excelQuestXP','proV2XP','xp','eq_pro_xp']);
  const skillsDirect = getFirstValue(['eq-skills','eqSkills','excelQuestSkills','proV2Skills','skills','eq_pro_skills']);
  const badgesDirect = getFirstValue(['eq-badges','eqBadges','excelQuestBadges','proV2Badges','badges','eq_pro_badges']);
  const nextDirect = getFirstValue(['eq-next-node','eqNextNode','excelQuestNextNode','proV2NextNode','nextBoss','nextSkill']);

  const xp = Number(xpDirect ?? inferNumberByKeyword(['xp'])) || 0;
  const skills = asArray(skillsDirect).length || inferArrayByKeyword(['skill']).length || 0;
  const badges = asArray(badgesDirect).length || inferArrayByKeyword(['badge']).length || 0;
  const next = (typeof nextDirect === 'string' && nextDirect.trim()) ? nextDirect : guessNextNode(skills, xp);

  const totalSkills = 12;
  const totalBadges = 6;
  const progress = Math.max(
    Math.round((skills/totalSkills)*100),
    Math.round((Math.min(xp,300)/300)*100),
    Math.round((badges/totalBadges)*100)
  );

  return {xp, skills, badges, next, progress, level:computeLevel(xp, skills)};
}
function renderBridge(){
  const p = bridgeProgress();
  const hasProgress = p.xp > 0 || p.skills > 0 || p.badges > 0;

  document.getElementById('statXp').textContent = p.xp;
  document.getElementById('statSkills').textContent = p.skills;
  document.getElementById('statBadges').textContent = p.badges;
  document.getElementById('statLevel').textContent = p.level;
  document.getElementById('proofXp').textContent = p.xp;
  document.getElementById('progressFill').style.width = p.progress + '%';
  document.getElementById('progressPercent').textContent = p.progress + '% progres estimat';
  document.getElementById('nextNodeText').textContent = p.next;

  const resumeHrefValue = resumeHref(p.next);
  ['resumeLink','heroContinue','finalContinue'].forEach(id => {
    const a = document.getElementById(id);
    if(a) a.href = resumeHrefValue;
  });

  if(hasProgress){
    document.getElementById('memoryStatus').textContent = 'Memorie găsită';
    document.getElementById('dashboardTitle').textContent = 'Hub-ul te recunoaște';
    document.getElementById('dashboardSub').textContent = 'Progresul citit din browser schimbă mesajul: nu mai e landing generic, e tablou de bord de reluare.';
    document.getElementById('resumeLabel').textContent = 'Continuă de unde ai rămas';
    document.getElementById('resumeSub').textContent = `Estimare: următorul punct relevant este „${p.next}”.`;
    document.getElementById('resumeLink').textContent = `Continuă de unde ai rămas → ${p.next}`;
    document.getElementById('heroContinue').textContent = 'Continuă quest-ul →';
    document.getElementById('finalContinue').textContent = `Continuă → ${p.next}`;
  } else {
    document.getElementById('memoryStatus').textContent = 'Fără progres detectat';
    document.getElementById('dashboardTitle').textContent = 'Încă nu ai progres salvat local';
    document.getElementById('dashboardSub').textContent = 'Aici hub-ul trebuie să funcționeze ca orientare: cine e începător merge în tutorial, cine vrea practică merge în Pro v2.';
    document.getElementById('resumeLabel').textContent = 'Alege traseul de start';
    document.getElementById('resumeSub').textContent = 'Enhanced Main pentru început, Pro v2 pentru provocare.';
    document.getElementById('resumeLink').textContent = 'Intră în Pro v2 →';
    document.getElementById('heroContinue').textContent = 'Vezi skill tree-ul →';
    document.getElementById('finalContinue').textContent = 'Începe quest-ul →';
  }
}
renderBridge();
