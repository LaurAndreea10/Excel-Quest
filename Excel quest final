.skill-node.done{border-color:rgba(33,115,70,.28);box-shadow:var(--shadow-sm)}
.skill-badge{display:inline-flex;align-items:center;gap:6px;width:max-content;padding:5px 10px;border-radius:999px;font-size:11px;font-weight:800;letter-spacing:.04em}
