<div class="toast-wrap" id="toastWrap"></div>

<script>
'use strict';

/* ═══════════════════════ TOAST ═══════════════════════ */
function toast(msg,type='ok'){
  const wrap=document.getElementById('toastWrap');
  const el=document.createElement('div');
  el.className='toast '+type;
  el.textContent=msg;
  wrap.appendChild(el);
  setTimeout(()=>{el.style.opacity='0';el.style.transform='translateX(20px)';el.style.transition='all .2s';setTimeout(()=>el.remove(),200);},2400);
}

/* ═══════════════════════ TABS ═══════════════════════ */
document.querySelectorAll('.play-tab').forEach(t=>{
  t.addEventListener('click',()=>{
    document.querySelectorAll('.play-tab').forEach(x=>x.classList.remove('active'));
    document.querySelectorAll('[data-tab-content]').forEach(x=>x.classList.remove('active'));
    t.classList.add('active');
    document.querySelector(`[data-tab-content="${t.dataset.tab}"]`).classList.add('active');
  });
});

/* ═══════════════════════ SKILL DEMO ═══════════════════════ */
const SKILLS_DEMO=[
  {id:'s1',title:'Formula Basics',desc:'SUM, AVERAGE, COUNT — fundamentele',xp:20,prev:null},
  {id:'s2',title:'IF Logic',desc:'Condiții simple și imbricate',xp:25,prev:'s1'},
  {id:'s3',title:'VLOOKUP',desc:'Căutare verticală cu IFERROR',xp:30,prev:'s2'},
];
const ST={skills:JSON.parse(localStorage.getItem('eq-final-skills')||'[]')};

function renderSkills(){
  const wrap=document.getElementById('skillDemo');
  wrap.innerHTML=SKILLS_DEMO.map(s=>{
    const isDone=ST.skills.includes(s.id);
    const prevDone=!s.prev||ST.skills.includes(s.prev);
    const isLocked=!isDone&&!prevDone;
    const status=isDone?'done':isLocked?'locked':'unlocked';
    const statusText=isDone?'✓ Completat':isLocked?'🔒 Blocat':'▶ Disponibil';
    return `<div class="skill-demo-card ${status}" onclick="${isLocked?`toast('Finalizează skill-ul anterior')`:isDone?`toast('Deja completat')`:`completeSkill('${s.id}')`}">
      <span class="sd-status ${status}">${statusText}</span>
      <h4>${s.title}</h4>
      <p>${s.desc}</p>
      <span class="sd-xp">+${s.xp} XP</span>
    </div>`;
  }).join('');
  updateMP();
}
function completeSkill(id){
  const s=SKILLS_DEMO.find(x=>x.id===id);
  if(!s||ST.skills.includes(id))return;
  ST.skills.push(id);
  localStorage.setItem('eq-final-skills',JSON.stringify(ST.skills));
  toast(`+${s.xp} XP — ${s.title}`);
  renderSkills();
}
function updateMP(){
  const total=SKILLS_DEMO.reduce((a,s)=>a+s.xp,0);
  const earned=SKILLS_DEMO.filter(s=>ST.skills.includes(s.id)).reduce((a,s)=>a+s.xp,0);
  const pct=Math.round(earned/total*100);
  document.getElementById('mpFill').style.width=pct+'%';
  document.getElementById('mpXp').textContent=earned+' XP';
  const t=document.getElementById('mpText'),sub=document.getElementById('mpSub');
  if(ST.skills.length===0){t.textContent='Apasă "Formula Basics" pentru a începe';sub.textContent='Primul skill se deblochează automat';}
  else if(ST.skills.length<SKILLS_DEMO.length){
    const next=SKILLS_DEMO.find(s=>!ST.skills.includes(s.id));
    t.textContent=`Următor: ${next.title}`;sub.textContent=`Mai ai ${SKILLS_DEMO.length-ST.skills.length} skill${SKILLS_DEMO.length-ST.skills.length>1?'-uri':''}`;
  } else {
    t.textContent='🎉 Toate skill-urile demo completate!';sub.textContent='Continuă în Pro v2 cu toate cele 12';
  }
}
renderSkills();

/* ═══════════════════════ FORMULA BUILDER ═══════════════════════ */
const KB=[
  {k:['suma','sumif','total','regiune'],f:'=SUMIF(A:A,"criteriu",B:B)',ex:'=SUMIF(A:A,"Nord",B:B)',info:'SUMIF adună valorile din B pentru rândurile unde A îndeplinește criteriul.'},
  {k:['suma multiple','sumifs'],f:'=SUMIFS(C:C,A:A,"crit1",B:B,"crit2")',ex:'=SUMIFS(D:D,A:A,"Nord",B:B,"Mere")',info:'SUMIFS adună cu condiții multiple. Coloana de sumat vine PRIMA.'},
  {k:['caută','prețul','cod','xlookup','lookup'],f:'=XLOOKUP(E1,A:A,C:C,"Nu există")',ex:'=XLOOKUP(E1,Produse[Cod],Produse[Pret],"—")',info:'XLOOKUP caută în A și returnează valoarea din C. Mai bun decât VLOOKUP.'},
  {k:['dacă','if','condiție'],f:'=IF(B2>0,"Profit","Pierdere")',ex:'=IF(AND(B2>=5,C2<>"Absent"),"Promovat","Respins")',info:'IF(condiție, adevărat, fals). Ghilimelele obligatorii pentru text.'},
  {k:['numără','count','countif'],f:'=COUNTIF(A:A,"criteriu")',ex:'=COUNTIF(A:A,"Nord")',info:'COUNTIF numără celulele care îndeplinesc condiția.'},
];
function setBuilder(v){document.getElementById('bInp').value=v;buildFormula();}
function buildFormula(){
  const text=document.getElementById('bInp').value.toLowerCase();
  const norm=s=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'');
  const qn=norm(text);
  let best=null,bestScore=0;
  for(const t of KB){let score=0;for(const k of t.k)if(qn.includes(norm(k)))score+=4;if(score>bestScore){bestScore=score;best=t;}}
  const r=document.getElementById('bRes');
  if(best){
    r.innerHTML=`<span class="res-formula">${best.f}</span><div class="res-info"><strong>Exemplu:</strong> <code>${best.ex}</code><br><br>${best.info}</div>`;
  } else {
    r.innerHTML='<span class="result-empty">Nu am găsit un template potrivit. Încearcă: sumă, caută, dacă, numără, total.</span>';
  }
}

/* ═══════════════════════ DEBUGGER ═══════════════════════ */
const RULES=[
  {test:f=>{let o=0,c=0;for(const ch of f){if(ch==='(')o++;if(ch===')')c++;}return o!==c;},msg:'Paranteze nepereche',fix:f=>{let o=0,c=0;for(const ch of f){if(ch==='(')o++;if(ch===')')c++;}return o>c?f+')'.repeat(o-c):f;},explain:'Fiecare ( trebuie să aibă un ) corespunzător.'},
  {test:f=>!/^=/.test(f.trim()),msg:'Formula nu începe cu =',fix:f=>'='+f.trim(),explain:'Fără = Excel tratează conținutul ca text simplu.'},
  {test:f=>/SUUM|AVRAGE|VLOKUP/i.test(f),msg:'Funcție scrisă greșit',fix:f=>f.replace(/SUUM/gi,'SUM').replace(/AVRAGE/gi,'AVERAGE').replace(/VLOKUP/gi,'VLOOKUP'),explain:'Excel nu recunoaște typo-uri în nume de funcții.'},
  {test:f=>/VLOOKUP.*,\s*TRUE\s*\)/i.test(f),msg:'VLOOKUP cu TRUE (aproximativ)',fix:f=>f.replace(/,\s*TRUE\s*\)/i,',0)'),explain:'TRUE face potrivire aproximativă. Pentru exactă folosește 0 (FALSE).'},
  {test:f=>/IF\s*\([^,]+,\s*[A-Za-z][A-Za-z0-9]*\s*\)/i.test(f)&&!f.includes('"'),msg:'Text în IF fără ghilimele',fix:f=>f.replace(/,\s*([A-Za-z][A-Za-z0-9]*)\s*\)/,',"$1")'),explain:'Textul în formule trebuie să fie între ghilimele duble.'},
];
function setDebug(v){document.getElementById('dInp').value=v;debugFormula();}
function debugFormula(){
  const f=document.getElementById('dInp').value.trim();
  const r=document.getElementById('dRes');
  if(!f){r.innerHTML='<span class="result-empty">Introdu o formulă.</span>';return;}
  for(const rule of RULES){
    if(rule.test(f)){
      const fix=rule.fix?rule.fix(f):null;
      r.innerHTML=`<div style="font-size:13.5px;color:var(--rust);font-weight:700;margin-bottom:6px">✗ ${rule.msg}</div><div class="res-info" style="margin-bottom:12px">${rule.explain}</div>${fix?`<div class="ba-grid"><div class="ba-cell before"><div class="ba-label">Înainte</div>${f}</div><div class="ba-cell after"><div class="ba-label">Fix sugerat</div>${fix}</div></div>`:''}`;
      return;
    }
  }
  r.innerHTML='<div style="font-size:13.5px;color:var(--excel-darkest);font-weight:700;margin-bottom:6px">✓ Formula pare validă sintactic</div><div class="res-info">Dacă tot nu merge, verifică tipurile de date cu <code>=ISNUMBER(A1)</code> sau referințele cu F9.</div>';
}

/* ═══════════════════════ REVEAL ON SCROLL ═══════════════════════ */
const io=new IntersectionObserver(entries=>{
  entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});
},{threshold:.12,rootMargin:'0px 0px -40px 0px'});
document.querySelectorAll('.reveal').forEach(el=>io.observe(el));
</script>
